# Cal.com event slugs ("user/event"). Leave empty until the account exists:
# booking buttons then open mailto:hallo@rideff.com instead.
NEXT_PUBLIC_CAL_BUSINESS=          # e.g. rideff/erstgespraech (30 min)
NEXT_PUBLIC_CAL_LIFE_PRIVATE=      # e.g. rideff/life-private (30 min)

# Client portal at portal.rideff.com. false = "Bald verfügbar" label, not clickable.
NEXT_PUBLIC_PORTAL_LIVE=false
