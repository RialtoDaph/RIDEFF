# Client portal (portal.rideff.com is a separate repo). Optional override,
# e.g. https://rideff-portal.vercel.app until the subdomain is set up.
NEXT_PUBLIC_PORTAL_URL=

# Where "RIDEFF Life" demo links point. Default: https://app.rideff.com/demo
NEXT_PUBLIC_LIFE_DEMO_URL=

# Newsletter (double opt-in). Provider: resend or brevo. Leave empty to disable sign-ups.
NEWSLETTER_PROVIDER=
NEWSLETTER_FROM=                   # e.g. RIDEFF <newsletter@rideff.com> (domain verified at the provider)
NEWSLETTER_SECRET=                 # random string, at least 32 characters (signs confirmation links)
RESEND_API_KEY=
RESEND_AUDIENCE_ID=
BREVO_API_KEY=
BREVO_LIST_ID=

# Nana providers: not wired yet, the /api/nana/* routes answer with mock data.
# Add the AI, voice, WhatsApp Business and Supabase keys here when wiring them (see TODO.md).
