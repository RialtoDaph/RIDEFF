# Client portal (portal.rideff.com is a separate repo). Optional override,
# e.g. https://rideff-portal.vercel.app until the subdomain is set up.
NEXT_PUBLIC_PORTAL_URL=

# RIDEFF Life web app (sign-up CTAs, Nav CTA on /life). Default: https://ridef-life.vercel.app (temporary).
# Set to https://app.rideff.com once that domain is live.
NEXT_PUBLIC_LIFE_APP_URL=

# Where "RIDEFF Life" demo links point. Default: <NEXT_PUBLIC_LIFE_APP_URL>/demo
NEXT_PUBLIC_LIFE_DEMO_URL=

# Newsletter (double opt-in). Provider: resend or brevo. Leave empty to disable sign-ups.
NEWSLETTER_PROVIDER=
NEWSLETTER_FROM=                   # e.g. RIDEFF <newsletter@rideff.com> (domain verified at the provider)
NEWSLETTER_SECRET=                 # random string, at least 32 characters (signs confirmation links)
RESEND_API_KEY=
RESEND_AUDIENCE_ID=
BREVO_API_KEY=
BREVO_LIST_ID=

# Nana on ElevenLabs Agents (voice call + text chat). Leave empty for mock answers.
# The agent "Nana · rideff.com" is created/updated automatically from src/lib/nana/agent-config.ts.
ELEVENLABS_API_KEY=                # server only, never NEXT_PUBLIC_; ElevenAgents: Write, Voices: Read
NANA_VOICE_ID=                     # ElevenLabs voice id (Voices → ⋯ → Copy voice ID)
NANA_TTS_MODEL=                    # optional: eleven_flash_v2_5 (default) | eleven_v4 | eleven_v4_turbo | eleven_multilingual_v2 | …
NANA_STABILITY=                    # optional: 0–100
NANA_SIMILARITY=                   # optional: 0–100
ELEVENLABS_REGION=                 # "eu" for an EU data residency workspace, otherwise empty
ELEVENLABS_AGENT_ID=               # optional: use an agent managed by hand in the dashboard instead
